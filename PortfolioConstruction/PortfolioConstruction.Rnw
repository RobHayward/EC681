\section{Expected values}
\begin{frame}{Introduction}
Some fundamentals
\begin{itemize}[<+-| alert@+>]
\pause
\item \textbf{Return}  What is expected from the investment
\item \textbf{Risk} How likely things will turn out different from expectations
\item There is \textbf{usually} a relationship between risk and return:  more return is required to  take more risk
\item When the market is \textbf{efficient}, return is just a compensation for taking risk
\item There is inefficiency when the return is more than just compensation for taking risk
\end{itemize}
\end{frame}

\begin{frame}{Expected return}
There are three methods of estimating the return that is likely to be received from an investment
\begin{itemize}[<+-| alert@+>]
\pause
\item \textbf{Using past performance} as a sample that can be used to estimate the population (including future) of returns
\item \textbf{Identifying the level of expected risk} (same problems in estimation) and using this to assess the return that would compensate for this risk
\item \textbf{Look into the future} and determine the return that you will receive
\end{itemize}
\end{frame}

\begin{frame}{Expected risk}
Expected risk involves the same estimation problem as expected return with added complication
\begin{itemize}[<+-| alert@+>]
\pause
\item Difference between \textbf{risk} and \textbf{uncertainty}
\begin{itemize}
\item Risk can be quantified
\item Risk is associated with probability
\item Uncertainty cannot be quantified 
\item Frank Knight (1921)
\item Keynes (1936)
\item Nassim Taleb (2007): \emph{Black Swan}
\end{itemize}
\end{itemize}
\end{frame}

\begin{frame}{Nassim Taleb}
\centering
\includegraphics{Taleb_mug}
\end{frame}

\begin{frame}{Sampling}
Take a \textbf{sample} and use that to understand the \textbf{population}
\pause
\begin{itemize}[<+-| alert@+>]
\item The sample is part of the population
\item The sample should be a random draw
\item No \emph{Confounding}
\begin{itemize}
\item This sample comes from the \textbf{good years}
\item This sample only includes \textbf{economic boom}
\end{itemize}
\item Usually: the larger the sample the better
\item Is the distant past still part of the population?
\item Do we need different regimes?
\end{itemize}
\end{frame}

\section{Diversification}
\begin{frame}{Introduction}
Some fundamentals
\pause
\begin{itemize}[<+-| alert@+>]
\item \textbf{Diversification} seeks to reduce risk
\pause
\begin{block}{}
\begin{quote}
``Don't put all your eggs in one basket``
\end{quote}
\end{block}
\pause
\item this can refer to
\begin{itemize}
\item stocks
\item assets
\item countries
\item currencies
\end{itemize}
\end{itemize}
\end{frame}

\begin{frame}{Risk aversion}
We assume that investors are \emph{risk averse}
\begin{itemize}[<+-| alert@+>]
\pause
\item Therefore, investors will need an incentive to take more risk
\item The greater the risk aversion, the greater the \emph{risk premium}
\item The assumption can be questioned
\begin{itemize}
\item gambling
\item meme stocks and bitcoin
\end{itemize}
\item Are there two pots of investment: savings vs entertainment?
\end{itemize}
\end{frame}

\begin{frame}{Expected value}
The \emph{Expected value} is the most likely.
\begin{itemize}[<+-| alert@+>]
\pause
\item It is the one that has been seen the most in the past
\item We usually take this as the \emph{mean value}
\begin{itemize}
\item it could be the median
\end{itemize}
\item We may colour that with future expectations
\end{itemize}
\end{frame}

\begin{frame}{Mean return}
\begin{columns}[T]
\begin{column}{0.48\textwidth}
<<BACH2, echo=FALSE, warning=FALSE, message=FALSE, fig.height=4.5>>=
BAC <- read.csv("../EMH/Data/BAC.csv")
BAC$Date <- as.Date(BAC$Date, format = "%d/%m/%Y")
colnames(BAC) <- c("Date", "Close")
BAC <- BAC[rev(rownames(BAC)),]
BACR <- diff(BAC$Close) / BAC$Close[-length(BAC$Close)]
BAC <- cbind(BAC[-1,], BACR)
hist(BAC$BACR, breaks = 10, ylab = "Frequency", col = "darkgreen", 
     main = "Histogram of Bank of America returns", xlab = "BAC return")
abline(v = mean(BAC$BACR, col = "black"), lwd = 3)
@
\end{column}
\begin{column}{0.48\linewidth}
\begin{block}{Mean}
\begin{align*}
\mu_{BACR} =& \frac{\sum_{t = 1}^T BACR_t}{T}\\
=& \frac{\Sexpr{round(sum(BAC$BACR),4)}}{\Sexpr{length(BAC$BACR)}}\\
=& \Sexpr{round(mean(BAC$BACR), 4)}
\end{align*}
\end{block}
\end{column}
\end{columns}
\end{frame}

\begin{frame}{Diversification 1}
\begin{columns}[T]
\begin{column}{0.48\linewidth}
No diversification
\begin{itemize}[<+-| alert@+>]
\pause
\item Two assets (A) and (B)
\item Two outcomes (50:50)
\begin{itemize}
\item Good (8\% return)
\item Bad (4\% return)
\end{itemize}
\end{itemize}
\end{column}
\pause
\begin{column}{0.48\linewidth}
Diversification
\rowcolors{1}{OliveGreen!20}{OliveGreen!5}
\begin{tabular}{lll}
& Asset B &\\
\hline
Asset A & Good & Bad\\
Good & 8 (1/4)& 6 (1/4)\\
Bad & 6 (1/4) & 4 (1/4)
\end{tabular}
\end{column}
\end{columns}
\end{frame}

\begin{frame}{Expected return}
\begin{columns}[T]
\begin{column}{0.48\textwidth}
\pause
No diversification
\begin{block}{}
\begin{equation*}
E[R_i] = \sum_{t=1}^T R_t/T
\end{equation*}
\end{block}
\pause
Refer to previous page
\begin{block}{}
\begin{align*}
E[R_i] &= \frac{8 + 4}{2}\\
&= 6
\end{align*}
\end{block}
\end{column}
\begin{column}{0.48\linewidth}
\pause
Diversification
\begin{block}{}
\begin{equation*}
E[R_i] = \sum_{t=1}^T R_t/T
\end{equation*}
\end{block}
\pause
Refer to previous page
\begin{block}{}
\begin{align*}
E[R_i] &= \frac{8 + 6 + 6 + 4}{4}\\
&= 6
\end{align*}
\end{block}
\end{column}
\end{columns}
\end{frame}

\begin{frame}{Expected risk}
\begin{columns}[T]
\begin{column}{0.48\textwidth}
\pause
No diversification
\begin{block}{}
\begin{equation*}
E[V_i] = \sum_{t=1}^T (R_t - \bar{R_i})^2/T
\end{equation*}
\end{block}
\pause
Refer to previous page
\begin{block}{}
\begin{align*}
[E[V_i] &= (2^2 + -2^2)/2\\
&= 4
\end{align*}
\end{block}
\end{column}
\begin{column}{0.48\linewidth}
\pause
Diversification
\begin{block}{}
\begin{equation*}
E[V_i] = \sum_{t=1}^T (R_t - \bar{R_i})^2/T
\end{equation*}
\end{block}
\pause
Refer to previous page
\begin{block}{}
\begin{align*}
E[R_i] &= \frac{2^2 + 0^2 + 0^2 - 2^2}{4}\\
&= 2
\end{align*}
\end{block}
\end{column}
\end{columns}
\end{frame}

