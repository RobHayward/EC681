@
\end{frame}

\begin{frame}{Covariance}
Covariance measures the relationship between two variables
\pause
\begin{block}{}
\begin{equation*}
Cov_{a, b} = \sum_{t = 1}^{t = T}\frac{(a_t - \bar{a})(b_t - \bar{b})}{T}
\end{equation*}
\end{block}
\pause
Correlation is the same measure but from -1 to +1
\begin{block}{}
\begin{equation*}
Corr_{a,b} = \frac{Cov_{a, b}}{Var(a)Var(b)}
\end{equation*}
\end{block}
\end{frame}

\begin{frame}{Diversification 2: correlation = 1}
\begin{columns}[T]
\begin{column}{0.48\linewidth}
Correlation equals 1
\begin{itemize}[<+-| alert@+>]
\pause
\item Two assets (A) and (B)
\item Two outcomes (50:50)
\begin{itemize}
\item Good (8\% return)
\item Bad (4\% return)
\end{itemize}
\end{itemize}
\end{column}
\pause
\begin{column}{0.48\linewidth}
Diversification
\rowcolors{1}{OliveGreen!20}{OliveGreen!5}
\begin{tabular}{lll}
& Asset B &\\
\hline
Asset A & Good & Bad\\
Good & 8 (1/2)& \\
Bad &  & 4 (1/2)
\end{tabular}
\end{column}
\end{columns}
\end{frame}

\begin{frame}{Diversification 3: correlation = -1}
\begin{columns}[T]
\begin{column}{0.48\linewidth}
Correlation equals -1
\begin{itemize}[<+-| alert@+>]
\pause
\item Two assets (A) and (B)
\item Two outcomes (50:50)
\begin{itemize}
\item Good (8\% return)
\item Bad (4\% return)
\end{itemize}
\end{itemize}
\end{column}
