\begin{frame}{ETF}
	Investment revolution
\begin{itemize}[<+-| alert@+>]
		\pause
	\item Tax efficient
	\item Economies of scale
	\item Phases
		\begin{itemize}
			\item Index
			\item Theme
			\item Active
		\end{itemize}
	\item Authorised particpants
\end{itemize}
\end{frame}

\begin{frame}{Hedge funds}
	They have evolved 
\begin{itemize}[<+-| alert@+>]
		\pause
	\item Alfred Jone 1949
	\item Macro funds
		\begin{itemize}
			\item George Soros
			\item Tudor Jones
			\item Ray Dalio
		\end{itemize}
	\item Quantitative (Renaissance Capital)
	\item Multi-manager \emph{Pod shop}
		\begin{itemize}
			\item Citadel
			\item Millennium
			\item Point72
		\end{itemize}
\end{itemize}
\end{frame}

\begin{frame}{Sovereign Wealth}
	They have evolved
\begin{itemize}[<+-| alert@+>]
		\pause
	\item Dutch disease (Norway)
	\item Reserve diversification (China)
	\item Strategic investment (Saudi, Abu Dhabi)
\end{itemize}
\end{frame}

