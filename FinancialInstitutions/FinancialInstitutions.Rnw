\section{Introduction}
\begin{frame}{Functions of finance}
\includegraphics[scale = 1.0]{FinSystem.jpeg}
\end{frame}

\begin{frame}{Functions of finance}
Functions of finance
\begin{itemize}[<+-| alert@+>]
\pause
\item Intermediate savings and borrowing
\item Transfer, allocate, pool and diversify risk
\item Manage the payments system
\end{itemize}
\end{frame}

\begin{frame}{Saving and borrowing}
The financial system must allow savers and borrowers to find each other. This can improve the position of each
\begin{itemize}[<+-| alert@+>]
\pause
\item Jane has \$100 spare for 1 year.  She would like a return of \$10 for delaying consumption; 
\item Alex has a project that requires \$100 to earn \$120 in one year.
\item everyone is better off as long as \emph{transaction costs} do not exceed \$10. 
\end{itemize}
\end{frame}

\begin{frame}{Transaction costs}
Transaction costs must be kept low to ensure that transactions are carried out and each side benefits.  The main transaction costs are:
\begin{itemize}[<+-| alert@+>]
\pause
\item search
\item verification
\item monitor
\item enforce
\end{itemize}
\pause

These will be affected by technology, changing the nature of the financial system. 
\end{frame}

\begin{frame}{Asymmetric information}
A major issue in finance is the imbalance of information 
\begin{itemize}[<+-| alert@+>]
\pause
\item \emph{Moral hazard}
\item \emph{Adverse selection}
\item \emph{Regulation}
\end{itemize}
\end{frame}

\begin{frame}{Other necessary factors}
The financial system also requires supportive infrastructure such as 
\begin{itemize}[<+-| alert@+>]
\pause
\item a legal system that works effectively
\item confidence and trust
\item institutions: banks, regulators, lawyers and many more
\end{itemize}
\pause
\vspace{1cm}
\includegraphics[scale = 0.05]{Enron}
\includegraphics[scale = 0.5]{Lehman}
\hspace{5mm}
\includegraphics[scale = 0.5]{swissbank}
\end{frame}

\section{Financial institutions}
\begin{frame}{Financial institutions}
There are four main types of financial institution
\pause
\begin{itemize}[<+-| alert@+>]
\item Commercial banks
\item Investment banks
\item Funds
\item Other
\end{itemize}
\pause
Many financial institutions are amalgamations of these.
\end{frame}

\begin{frame}{Commercial bank}
\begin{figure}
\begin{tikzpicture}[scale = 0.75]
%\draw [very thin, color = gray](0, 0) grid (14, 7);
\draw [thick] (2, 6) to (12, 6);
\draw [thick] (7, 7) to (7, 0);
\node [above] at (10, 6) {Liabilities};
\node [above] at (4, 6) {Assets};
\node [right] at (7, 5) {Deposits 1000};
\node [left] at (7, 5) {Cash 100};
\node [right] at (7, 4) {Borrowing 200};
\node [left] at (7, 4) {Loans 1200};
\draw (3, 2) to (11, 2);
\node [right] at (7, 3) {Capital 200};
\node [left] at (7, 3) {Buildings etc. 100};
