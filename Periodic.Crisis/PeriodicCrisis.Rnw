\end{frame}

\section{Theory}
\begin{frame}{Creative Destruction}
\begin{itemize}[<+-| alert@+>]
		\pause
\item Schumpeter
\begin{itemize}
\item The creation of new industries and ideas
\item The new replaces the old
\end{itemize}
\item Marx
\begin{itemize}
\item The destruction of capitalism
\item Destroys the old ways of doing things
\item Crisis to keep workers subservient
\end{itemize}
\end{itemize}
\end{frame}

\begin{frame}{Fisher's debt deflation}
Irvin Fisher identified nine factors behind the \emph{Great Depression}
\begin{itemize}[<+-| alert@+>]
\pause
\item Over-indebtedness; 
\item Collapse in the volume of currency; 
\item A falling price level; 
\item A decline in net worth; 
\item Declining profits; 
\item Falling production, trade and employment; 
\item The replacement of optimism with pessimism; 
\item The hoarding of cash and the slowing of velocity of circulation; 
\item The constraint imposed by the inability of the nominal rate of interest to fall below zero 
\end{itemize}
\end{frame}

\begin{frame}{Fisher findings}
As a result of Fisher
\begin{itemize}[<+-| alert@+>]
\pause
\item The effects of default were more widely assessed
\item Default does more than just re-distribute wealth
\item Deflation increases the real burden of debt
\item Bernanke: default can affect bank balance sheet and credit supply 
\item Importance of preventing deflation
\end{itemize}
\end{frame}

\begin{frame}{Anatomy of typical crisis}
\begin{block}{}
Charles P Kindleberger, \textbf{Manias, Crashes and Panics: A history of financial crisis}
\end{block}
\pause
Drawing from a detailed examination of 46 episodes from 1618 to the present. 
\end{frame}

\begin{frame}{Kindleberger anatomy}
Kindleberger identifies five key components
\pause
\begin{itemize}[<+-| alert@+>]
\item Displacement
\item Credit boom 
\item Speculation
\item Tipping point
\item Revulsion 
\end{itemize}
\end{frame}

\begin{frame}{Hyman Minsky}
There is inherent instability in the system.  The \emph{Financial Instability Hypothesis} (FIH)
\begin{itemize}[<+-| alert@+>]
		\pause
\item The economy will evolve from one of \emph{hedge financing}
\item To \emph{speculative financing}
\begin{itemize}[<+-| alert@+>]
\item Debt-to-equity ratio rises
\item Repayments are high relative to income
\end{itemize}
\item \emph{Ponzie Finance} where income is insufficient to pay interest or principal 
\end{itemize}
\end{frame}

\begin{frame}{Minsky Moment}
The reversal is brutal
\begin{itemize}[<+-| alert@+>]
		\pause
\item It is very hard to determine when the bubble will burst
\item The crash is more intense and explosive than the build up of instability
\item Financial institutions are interconnected.  There are non-linear network effects
\item Like a cinema or football ground
\end{itemize}
\end{frame}

\section{Case studies}
\section{Asian crisis}

\begin{frame}{Sudden Stops}
Krugman and others analysed the process of the Asian crisis.  It also applies to the ERM and elsewhere
\begin{itemize}[<+-| alert@+>]
		\pause
\item There is some fundamental imbalance or weakness
\item There are speculative attacks on fixed exchange rates
\item \emph{Hedge Funds} Use leverage to increase the size of their bets
\item Crash requires overseas borrowing (to plug the loss of foreign exchange reserves)
\item IMF have imposed austerity measures on the top of collapse of financial system and devaluation of the exchange rate
\end{itemize}
\end{frame}

\begin{frame}{Sudden Stops 2}
This is most frequently associated with fixed exchange rates, a reversal of currency flow and banking crisis
\begin{itemize}[<+-| alert@+>]
		\pause
\item Positive attitude encourages inflow of capital
\item Wages and asset prices rise
\item Central Bank fights exchange rate appreciation
\item Low interest foreign currency loans increase fragility
\end{itemize}
\end{frame}

