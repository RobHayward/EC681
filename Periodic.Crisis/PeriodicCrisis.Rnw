\begin{frame}{Case study 1: Greece}
On-going. Greece aims to have a primary surplus of 3.5\% of GDP but has outstanding debt of 179\% of GDP
\begin{block}{}
\begin{equation}\label{eqref:debt}
\Delta \frac{D_t}{Y_t} = d_p + (r - g)\frac{D_{t-1}}{Y_{t-1}}
\end{equation}
\end{block}
\end{frame}

\begin{frame}{Debt sustainability 1}
\begin{block}{}
\begin{equation}\label{eqref:debt1}
\frac{D_t}{Y_t} = d_p + (1 + r - g)\frac{D_{t-1}}{Y_{t-1}}
\end{equation}
\end{block}
Where $D_t$ is the level of debt at time $t$; $Y_t$ is the \emph{nominal} GDP at time $t$; $d-P$ is the primary government deficit; $r$ is the average interest payment on the debt; $g$ is the growth rate of nominal GDP.
\end{frame}

\begin{frame}{Debt sustainability 2}
Re-arranging Equation \ref{eqref:debt1}
\begin{block}{}
\begin{equation}\label{eqref:debt2}
\frac{D_t}{Y_t} = d_p + \frac{D_{t-1}}{Y_{t-1}} + (r - g)\frac{D_{t-1}}{Y_{t-1}}
\end{equation}
\end{block}
and therefore,
\begin{block}{}
\begin{equation}\label{eqref:debt3}
\Delta \frac{D_t}{Y_t} = d_p + (r - g)\frac{D_{t-1}}{Y_{t-1}}
\end{equation}
\end{block}
\end{frame}

\begin{frame}{Debt Sustainability 3}
If the ratio of debt to GDP remains stable, that could be considered to be sustainable.  Therefore, if $\Delta \frac{D_t}{Y_t}$ is set to zero, Equation \ref{eqref:debt3} becomes 
\begin{block}{}
\begin{equation}\label{eqref:debt4}
0 = d_p + (r - g)\frac{D_{t-1}}{Y_{t-1}}
\end{equation}
\end{block}
\end{frame}

\begin{frame}{Debt Sustainability 4}
This makes it very clear that, with the ratio of debt to GDP $(\frac{D_{t-1}}{Y_{t-1}})$ given, sustainability depends on 
\pause
\begin{itemize}[<+-| alert@+>]
\item The primary balance $(d_p)$
\item The average interest paid on the debt $(r)$ 
\item The rate of nominal GDP growth $(g)$.  
\end{itemize}
\pause
Therefore, for the debt to be sustainable, the primary balance must be equal to the difference between the rate of interest paid on the debt and the rate of nominal growth in the economy. 
\end{frame}

\begin{frame}{Primary balance}
Taxation $(T)$ and Government spending $(G)$ are affected by the rate of economic growth $(g)$
\begin{block}{}
\begin{equation}
T = \beta_1(Y), \qquad \beta_1 > 0;
\end{equation}
\end{block}
and
\begin{block}{}
\begin{equation}
G = \beta_2(Y), \qquad \beta_2 < 0;
\end{equation}
\end{block}
\end{frame}

\section{Swiss franc mortgages}
\begin{frame}{Swiss franc mortgages}
	Swiss and Austrian banks moved into CEE
\begin{itemize}[<+-| alert@+>]
		\pause
	\item PLN and HUF mortgages are 10\%
	\item CHF mortgage are 1\%
	\item SNB promise to keep exchange rate fixed
	\item Until Jan 15 2015
\end{itemize}
\end{frame}

\begin{frame}{Swiss franc}
	January 15 2015
\begin{itemize}[<+-| alert@+>]
		\pause
	\item Exchange rate cap of EUR 1.2
	\item Abandoned with 20-30 pecent appreciation
	\item Interest rates cut to -0.25-0.75\%
	\item Hungary vs Poland
		\begin{itemize}
			\item \$25bn cost to Polish banks
		\end{itemize}
\end{itemize}
\end{frame}

\begin{frame}{PLNCHF}
<<PLNCHF, fig.height=4.5, echo=FALSE, message=FALSE,warning=FALSE,fig.cap="PLNCHF">>=
da1 <- read.csv('../../Data/CHFPLN.csv', na.strings = "n/a")
da1$Date <- as.Date(da1$Date, format = "%d %b %y")
da2 <- read.csv('../../Data/CHFHUF.csv', na.strings = "n/a") 
da2$Date <- as.Date(da2$Date, format = "%d %b %y")
# Merge the two files
da <- merge(da1, da2, by = "Date")
# Create the Swiss rates
da$PLNCHF <- da$PLN/da$CHF.x
da$HUFCHF <- da$HUF/da$CHF.y
da <- da[complete.cases(da), ]
da <- da[, c(1, 6, 7)]
enddate <- as.Date("2015-12-31") 
startdate <- as.Date("2014-01-01")
shockdate <- as.Date("2015-01-15")
dasubset <- da[da$Date > startdate & da$Date < enddate, ]
dabefore <- da[da$Date > startdate & da$Date < shockdate, ]
daafter <- da[da$Date > shockdate & da$Date < enddate, ]
plot(dasubset$Date, dasubset$PLNCHF, type = 'l', 
	main = "CHF rises 14 percent vs PLN", 
	   xlab = "Date", ylab = "PLN/CHF")
PLNbeforeaverage <- mean(dabefore$PLNCHF)
PLNafteraverage <- mean(daafter$PLNCHF)
lines(dabefore$Date, rep(PLNbeforeaverage, length(dabefore$Date)), 
    col = 'red')
lines(daafter$Date, rep(PLNafteraverage, length(daafter$Date)), 
  col = 'red')
mybefore <- paste("Average", round(PLNbeforeaverage, 2))
text(shockdate + 90, PLNbeforeaverage, mybefore, cex = 0.8)
lines(daafter$Date, rep(PLNafteraverage, length(daafter$Date)), 
   col = 'red')
lines(daafter$Date, rep(PLNafteraverage, length(daafter$Date)), 
	col = 'red')
myafter <- paste("Average", round(PLNafteraverage, 2))
text(shockdate - 90, PLNafteraverage, myafter, cex = 0.8)
@
\end{frame}

\begin{frame}{HUFCHF}
<<HUFCHF, fig.height=4.5, echo=FALSE, message=FALSE,warning=FALSE,fig.cap="HUFCHF">>=
plot(dasubset$Date, dasubset$HUFCHF, type = 'l', 
     main = "CHF rises 14 percent vs HUF", 
     xlab = "Date", ylab = "HUF/CHF")
HUFbeforeaverage <- mean(dabefore$HUFCHF)
HUFafteraverage <- mean(daafter$HUFCHF)
lines(dabefore$Date, rep(HUFbeforeaverage, length(dabefore$Date)), 
                         col = 'red')
lines(daafter$Date, rep(HUFafteraverage, length(daafter$Date)), 
      col = 'red')
mybefore <- paste("Average", round(HUFbeforeaverage, 2))
text(shockdate + 100, HUFbeforeaverage, mybefore, cex = 0.8)
myafter <- paste("Average", round(HUFafteraverage, 2))
text(shockdate - 100, HUFafteraverage, myafter, cex = 0.8)
@
\end{frame}

