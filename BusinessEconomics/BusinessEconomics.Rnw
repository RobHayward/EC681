\end{columns}
Equilibrium price = $p^* = AR = MR$
\end{frame}

\begin{frame}{Profit maximisation 1}
It is hard to know how firms move towards the profit-maximising position.
\begin{itemize}[<+-| alert@+>]
\pause
\item Management skill
\item Trial and error
\item Luck
\item Something else
\end{itemize}
\end{frame}

\begin{frame}{Profit maximisation 2}
Profit maximisation \textbf{MUST} happen when
\pause
\begin{block}{}
MC = MR
\end{block}
\pause
Otherwise, profits can be increased
\end{frame}

\begin{frame}{Profit maximisation 3}
Profit maximised at MR = MC
