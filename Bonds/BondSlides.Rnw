\section{Introduction}
\begin{frame}{Introduction}
\begin{itemize}[<+-| alert@+>]
\pause
\item Debt is an IOU
\item Firms and the government issue debt securities
\item The \emph{maturity} of the debt is the time until it is repaid
\item Categories
\begin{itemize} 
\item less than one year: tbills or commercial paper (at discount)
\item more than one year: bonds (usually have a coupon)
\end{itemize}
\item Traditionally clipped \emph{the coupon}
\item The yield is a \emph{benchmark} and related to the fundamental or \emph{real interest rate} or $\mathbf{R^*}$
\end{itemize}
\end{frame}

\begin{frame}{Risk free rate}
<<rr, fig.height=4.6, echo=FALSE, warning=FALSE,message=FALSE>>=
