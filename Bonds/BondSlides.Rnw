\section{The yield curve}
\begin{frame}{The yield curve}
There are three theories to explain the shape of the yield curve
\begin{itemize}[<+-| alert@+>]
\pause
\item Expectations
\item Segmented market/preferred habit
\item Liquidity preference
\end{itemize}
\end{frame}

\begin{frame}{Liquidity premium}
	\includegraphics[scale = 0.3]{Aust100Y}
\end{frame}

\begin{frame}{The Term premium}
	The \emph{term premium} will encompass:
\begin{itemize}[<+-| alert@+>]
		\pause
	\item Interest rate expectations
	\item Liquidity premium
	\item Other
		\begin{itemize}
			\item volatility
			\item convenience
			\item investment (diverification)
		\end{itemize}
\end{itemize}
\end{frame}

