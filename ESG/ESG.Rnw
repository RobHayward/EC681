\section{Issues}
\begin{frame}{Issues}
There are a number of issues associated with ESG
\begin{itemize}[<+-| alert@+>]
\pause
\item The rise of passive investment may conflict with ESG aims
\begin{itemize}
\item but it gives \emph{owners} a broader perspective
\end{itemize}
\item The difficulty of measurement and lack of standardisation 
\begin{itemize}
\item lack of benchmarks 
\item lack of accounting standards equivalent
\item how are external managers to be evaluated?
\item avoidance of \emph{greenwashing}
\end{itemize}
\end{itemize}
\end{frame}

\begin{frame}{Measurement}
\begin{itemize}[<+-| alert@+>]
