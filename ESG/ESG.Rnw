\section{UN}
\begin{frame}{United Nations}
UN 17 Sustainable Development Goals
\begin{itemize}[<+-| alert@+>]
\pause
\item UN Principles for Responsible Investment
\item Lunched in 2015 to supplement the Millennium Development Goals
\item Includes climate change, gender equality and eradication of poverty
\end{itemize}
\end{frame}

\begin{frame}{Principles for Responsible Investment}
PRI
\begin{enumerate}[<+-| alert@+>]
\pause
\item Incorporate ESG into analysis and decisions
\item Be active in ownership for ESG factors
\item Seek appropriate ESG disclosure
\item Promote acceptance and implementation of PRI
\item Work to enhance the effectiveness of PRI
\item Report progress in implementing  PRI
\end{enumerate}
\end{frame}

\begin{frame}{New Accounting Rules}
UK and EU were at the forefront 
\begin{itemize}[<+-| alert@+>]
\pause
\item Financial Conduct Authority (FCA) announced measures on in March 2020
\item UK-listed firms 
\begin{itemize}
\item climate-related disclosures
\item climate risk and opportunities
\end{itemize}
\item EU regulations require on-line publication of sustainability impacts
\item Biden administration in US is bogged down in Republican legal challenges
\begin{itemize}
\item Erisa, the Employee Retirement Income Security Act of 1974, sets out precise fiduciary requirements for regulated pension funds
\end{itemize}
\end{itemize}
\end{frame}
\section{Case studies}
\begin{frame}{RepRisk Business Intelligence Index (RRI}
Identifies vulnerable projects, firms and sectors
\begin{itemize}[<+-| alert@+>]
\pause 
\item Monitors 28 ESG topics and 45 topic tags
\item Based on authenticity and novelty
\item RR Rating from AAA to D
\item Index will return to zero after 2 years of no incidents
\item \href{https://www.reprisk.com/our-approach}{https://www.reprisk.com/our-approach}
\end{itemize}
\end{frame}

\begin{frame}{North sea assets}
	North sea assets shifted to private companies
\begin{itemize}[<+-| alert@+>]
		\pause
	\item Direct private sales or ring-fenced joint ventures
	\item No consumer brand to protect
	\item Immune from activist shareholders
	\item Lower public disclosure
\end{itemize}
\end{frame}

