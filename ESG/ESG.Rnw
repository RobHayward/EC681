\begin{frame}{All in ESG}
	\begin{block}{2018-22}
		\begin{itemize}
			\item 2018 letter said "companies must show that they always make a positive contribution to society"
			\item 2020: "Climate risk is investment risk"
			\item 2022: said staeholder capitalism "is not woke"
		\end{itemize}
		\end{block}
\end{frame}

\begin{frame}{Pivot from ESG}
	\begin{block}{2023-24}
		\begin{itemize}
			\item June 2023: Fink said he as \emph{ashamed} of being part of the ESG conversation
			\item Stoped using the term "ESG"
			\item 2024 annual letter made no mention of ESG
		\end{itemize}
	\end{block}
\end{frame}

